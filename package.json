{
  "name": "smartbill",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @smartbill/api dev\" \"pnpm --filter @smartbill/web dev\"",
    "dev:api": "pnpm --filter @smartbill/api dev",
    "dev:web": "pnpm --filter @smartbill/web dev",
    "dev:mobile": "pnpm --filter @smartbill/mobile start",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @smartbill/api prisma:generate",
    "db:migrate": "pnpm --filter @smartbill/api prisma:migrate",
    "db:seed": "pnpm --filter @smartbill/api prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}