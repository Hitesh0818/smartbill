generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { OWNER ADMIN STAFF ACCOUNTANT }
enum InvoiceStatus { DRAFT ISSUED PARTIALLY_PAID PAID OVERDUE CANCELLED }
enum PaymentMode { CASH BANK_TRANSFER UPI CARD CHEQUE OTHER }
enum StockMovementType { OPENING_STOCK PURCHASE SALE SALE_RETURN PURCHASE_RETURN ADJUSTMENT_IN ADJUSTMENT_OUT }

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  memberships FirmMember[]
  createdInvoices Invoice[] @relation("InvoiceCreator")
}
model Firm {
  id String @id @default(cuid())
  name String
  gstin String? @unique
  state String?
  stateCode String?
  invoicePrefix String @default("INV")
  nextInvoiceNumber Int @default(1)
  createdAt DateTime @default(now())
  members FirmMember[]
  customers Customer[]
  products Product[]
  invoices Invoice[]
  payments Payment[]
  stockMovements StockMovement[]
}
model FirmMember {
  id String @id @default(cuid())
  firmId String
  userId String
  role UserRole @default(STAFF)
  firm Firm @relation(fields:[firmId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([firmId,userId])
}
model Customer {
  id String @id @default(cuid())
  firmId String
  name String
  phone String?
  email String?
  gstin String?
  addressLine String?
  state String?
  stateCode String?
  openingDue Decimal @default(0) @db.Decimal(14,2)
  createdAt DateTime @default(now())
  firm Firm @relation(fields:[firmId],references:[id],onDelete:Cascade)
  invoices Invoice[]
  payments Payment[]
  @@index([firmId,name])
}
model Product {
  id String @id @default(cuid())
  firmId String
  name String
  sku String?
  unit String @default("PCS")
  hsnSac String?
  gstRate Decimal @default(18) @db.Decimal(5,2)
  salePrice Decimal @default(0) @db.Decimal(14,2)
  currentStock Decimal @default(0) @db.Decimal(14,3)
  reorderLevel Decimal? @db.Decimal(14,3)
  createdAt DateTime @default(now())
  firm Firm @relation(fields:[firmId],references:[id],onDelete:Cascade)
  invoiceItems InvoiceItem[]
  stockMovements StockMovement[]
  @@unique([firmId,sku])
  @@index([firmId,name])
}
model Invoice {
  id String @id @default(cuid())
  firmId String
  customerId String
  createdById String
  invoiceNumber String
  invoiceDate DateTime @default(now())
  dueDate DateTime?
  status InvoiceStatus @default(ISSUED)
  notes String?
  subtotal Decimal @default(0) @db.Decimal(14,2)
  discountTotal Decimal @default(0) @db.Decimal(14,2)
  taxableTotal Decimal @default(0) @db.Decimal(14,2)
  cgstTotal Decimal @default(0) @db.Decimal(14,2)
  sgstTotal Decimal @default(0) @db.Decimal(14,2)
  igstTotal Decimal @default(0) @db.Decimal(14,2)
  taxTotal Decimal @default(0) @db.Decimal(14,2)
  grandTotal Decimal @default(0) @db.Decimal(14,2)
  amountPaid Decimal @default(0) @db.Decimal(14,2)
  balanceDue Decimal @default(0) @db.Decimal(14,2)
  createdAt DateTime @default(now())
  firm Firm @relation(fields:[firmId],references:[id],onDelete:Cascade)
  customer Customer @relation(fields:[customerId],references:[id])
  createdBy User @relation("InvoiceCreator",fields:[createdById],references:[id])
  items InvoiceItem[]
  payments Payment[]
  @@unique([firmId,invoiceNumber])
  @@index([firmId,invoiceDate])
}
model InvoiceItem {
  id String @id @default(cuid())
  invoiceId String
  productId String?
  name String
  hsnSac String?
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(14,2)
  discountPct Decimal @default(0) @db.Decimal(5,2)
  discountAmt Decimal @default(0) @db.Decimal(14,2)
  taxableValue Decimal @default(0) @db.Decimal(14,2)
  gstRate Decimal @default(0) @db.Decimal(5,2)
  cgstAmount Decimal @default(0) @db.Decimal(14,2)
  sgstAmount Decimal @default(0) @db.Decimal(14,2)
  igstAmount Decimal @default(0) @db.Decimal(14,2)
  total Decimal @default(0) @db.Decimal(14,2)
  invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Cascade)
  product Product? @relation(fields:[productId],references:[id])
}
model Payment {
  id String @id @default(cuid())
  firmId String
  customerId String
  invoiceId String?
  amount Decimal @db.Decimal(14,2)
  mode PaymentMode
  reference String?
  paymentDate DateTime @default(now())
  firm Firm @relation(fields:[firmId],references:[id],onDelete:Cascade)
  customer Customer @relation(fields:[customerId],references:[id])
  invoice Invoice? @relation(fields:[invoiceId],references:[id])
}
model StockMovement {
  id String @id @default(cuid())
  firmId String
  productId String
  type StockMovementType
  quantity Decimal @db.Decimal(14,3)
  referenceId String?
  createdAt DateTime @default(now())
  firm Firm @relation(fields:[firmId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id])
}
